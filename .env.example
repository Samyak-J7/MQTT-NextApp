# Copy this to .env.local and fill in your values
# cp .env.example .env.local

# ── AWS (DynamoDB) ───────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── NextAuth ─────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000   # change to your Vercel URL in production

# ── Bridge security ──────────────────────────
# Must match BRIDGE_API_KEY in mqtt-bridge/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_API_KEY=

# Public URL of the deployed bridge (Fly/Railway) — used to push an instant
# schedule-refresh notification when a schedule is added/removed. Optional:
# without it, the bridge just re-syncs on its periodic fallback interval.
BRIDGE_URL=https://your-bridge.fly.dev

# ── MQTT (OMS switch control) ─────────────────
# Same broker credentials as mqtt-bridge/.env
MQTT_BROKER=your-broker.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_USE_TLS=true
