# Copy this to .env and fill in your values
# cp .env.example .env

# ── MQTT Broker ──────────────────────────────
MQTT_BROKER=your-broker.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_FLOW_TOPIC=pit_fbk/flow
MQTT_STATUS_TOPIC=pit_fbk
MQTT_USE_TLS=true
MQTT_CLIENT_ID=bridge-prod

# Field name used in status pings to identify the device (default: device_id)
# STATUS_DEVICE_ID_FIELD=device_id

# Minimum seconds between heartbeat API calls per device (default: 10)
# HEARTBEAT_DEBOUNCE=10

# ── Backend API ──────────────────────────────
API_URL=https://your-app.vercel.app/api

# Must match BRIDGE_API_KEY in your Vercel environment variables.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_API_KEY=

# ── Logging ──────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# How often to print stats summary (seconds). Default 300 = every 5 min.
STATS_INTERVAL=300
